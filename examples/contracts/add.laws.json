{
  "version": 1,
  "name": "exact integer addition",
  "target": "examples.pure:add",
  "mode": "pure",
  "inputs": {
    "a": {"type": "int", "min": -4, "max": 4},
    "b": {"type": "int", "min": -4, "max": 4}
  },
  "requires": [],
  "ensures": [
    "result == input.a + input.b",
    "result - input.a == input.b"
  ],
  "testing": {"seed": 17, "mode": "exhaustive", "max_cases": 100}
}
